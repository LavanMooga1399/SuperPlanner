# SuperPlanner configuration (PHASE2B 5.1, docs/DEPLOY.md section 4). Copy to `.env` (git-ignored) and edit.
# docker compose reads it for the containers and for ${...} substitution in docker-compose.yml.
# Local zero-setup development needs NO .env at all (SQLite, inline jobs, single-user).
# Values here are dev-safe placeholders - never commit real secrets.

# ---------------------------------------------------------------- compose / PostgreSQL
POSTGRES_DB=superplanner
POSTGRES_USER=superplanner
POSTGRES_PASSWORD=change-me
# Published port of the frontend (nginx); put your TLS proxy / load balancer in front of it.
HTTP_PORT=8080
WORKER_REPLICAS=2
# Fixed internal docker network; the API trusts X-Forwarded-For only from here (never "*").
SP_INTERNAL_SUBNET=172.28.0.0/24
SP_IMAGE_TAG=latest

# ---------------------------------------------------------------- environment and database
# development | production (compose sets production; it changes the defaults marked "prod:")
SP_ENV=production
# Compose builds DATABASE_URL from the POSTGRES_* values above. Outside compose set it yourself:
# DATABASE_URL=postgresql+psycopg://superplanner:change-me@127.0.0.1:5432/superplanner
# DATABASE_URL=sqlite:///C:/path/to/superplanner.db      (Windows path example; dev default: backend/superplanner.db)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=30000
# default: true for SQLite, false for PostgreSQL (compose runs the one-shot `migrate` service instead)
DB_AUTO_MIGRATE=false

# ---------------------------------------------------------------- jobs and workers
# inline (SQLite default) | queue (PostgreSQL default; inline+PostgreSQL is refused in production)
JOB_BACKEND=queue
# inline thread pool size; also what WORKER_EMBEDDED=auto means
RUN_WORKERS=2
# queue mode: worker threads inside the API (dev default auto, prod: 0 = separate worker containers)
WORKER_EMBEDDED=0
WORKER_CONCURRENCY=2
WORKER_KINDS=solver_run,finance_run
# WORKER_ID=                     (default <hostname>:<pid>:<random>)
WORKER_METRICS_PORT=9101
WORKER_POLL_SECONDS=1.0
WORKER_SHUTDOWN_GRACE_SECONDS=30
JOB_LEASE_SECONDS=30
JOB_HEARTBEAT_SECONDS=10
JOB_CANCEL_POLL_SECONDS=1.0
JOB_REAPER_SECONDS=15
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_SECONDS=5
JOB_BACKOFF_MAX_SECONDS=300
JOB_RETENTION_DAYS=30
IDEMPOTENCY_TTL_HOURS=24

# ---------------------------------------------------------------- accounts
# single_user (dev default) | accounts (prod default)
AUTH_MODE=accounts
ALLOW_SINGLE_USER_IN_PRODUCTION=false
SIGNUP_ENABLED=true
SESSION_MAX_AGE_DAYS=30
SESSION_IDLE_DAYS=7
# prod default true: the session cookie is only sent over https (TLS at your proxy)
COOKIE_SECURE=true
# The public origin users open in the browser (Origin check). Required in production with accounts.
PUBLIC_BASE_URL=https://planner.example.com
# default | fast (tests only; refused in production)
PASSWORD_HASH_PROFILE=default
AUTH_RATE_LIMIT_ENABLED=true
AUTH_SIGNIN_LIMIT_PER_IP=30
AUTH_SIGNIN_LIMIT_PER_EMAIL=10
AUTH_SIGNUP_LIMIT_PER_IP=5
AUTH_CHANGE_PASSWORD_LIMIT_PER_USER=10
# Comma list of origins allowed by CORS (prod default empty = same-origin through nginx; never "*" with accounts)
CORS_ORIGINS=
# CIDRs of an external load balancer in front of nginx (nginx set_real_ip_from); empty = none
TRUSTED_PROXY_CIDRS=
MAX_BODY_BYTES=5242880

# ---------------------------------------------------------------- operations
LOG_LEVEL=INFO
# text (dev default) | json (prod default)
LOG_FORMAT=json
METRICS_ENABLED=true
# If set, GET /metrics needs "Authorization: Bearer <token>". Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=
# uvicorn proxy headers: who may set X-Forwarded-For. Compose sets it to SP_INTERNAL_SUBNET. Never "*".
FORWARDED_ALLOW_IPS=127.0.0.1
# run_api.sh / run_api.ps1 bind address and port (the API image listens on 0.0.0.0:8000)
HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------- intake AI assist (optional, PHASE2 2.12)
INTAKE_AI_ENABLED=false
INTAKE_AI_TIMEOUT_SECONDS=60
# Only if INTAKE_AI_ENABLED=true; keep the real key out of version control.
# ANTHROPIC_API_KEY=
